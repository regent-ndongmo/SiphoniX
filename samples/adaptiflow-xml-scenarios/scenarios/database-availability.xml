<scenarios>
  <scenario id="database-availability" pluginId="adaptiflow.database-availability" enabled="true" intervalMs="5000">
    <events>
      <event id="database-available" type="ConditionalEvent">
        <collector type="ResourceUsageCollector"/>
        <evaluators>
          <evaluator type="IncreaseResourceUsageEvaluator">
            <parameters>
              <parameter key="constructorArgTypes">
                <list>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                </list>
              </parameter>
              <parameter key="constructorArgs">
                <list>
                  <value>75.0</value>
                  <value>80.0</value>
                </list>
              </parameter>
            </parameters>
          </evaluator>
        </evaluators>
        <actions>
          <action type="RestAdaptationAction">
            <parameters>
              <parameter key="constructorArgTypes">
                <list>
                  <value>java.util.List</value>
                  <value>java.lang.String</value>
                  <value>java.lang.String</value>
                </list>
              </parameter>
              <parameter key="constructorArgs">
                <list>
                  <list>
                    <value>DatabaseAvailableEventBroadcast</value>
                  </list>
                  <value>http://image:8080/tools.descartes.teastore.image/rest/adapt</value>
                  <value>EnableExternalImageProvider</value>
                </list>
              </parameter>
            </parameters>
          </action>
        </actions>
      </event>
      <event id="database-unavailable" type="ConditionalEvent">
        <collector type="ResourceUsageCollector"/>
        <evaluators>
          <evaluator type="DecreaseResourceUsageEvaluator">
            <parameters>
              <parameter key="constructorArgTypes">
                <list>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                </list>
              </parameter>
              <parameter key="constructorArgs">
                <list>
                  <value>60.0</value>
                  <value>60.0</value>
                </list>
              </parameter>
            </parameters>
          </evaluator>
        </evaluators>
        <actions>
          <action type="RestAdaptationAction">
            <parameters>
              <parameter key="constructorArgTypes">
                <list>
                  <value>java.util.List</value>
                  <value>java.lang.String</value>
                  <value>java.lang.String</value>
                </list>
              </parameter>
              <parameter key="constructorArgs">
                <list>
                  <list>
                    <value>DatabaseUnavailableEventBroadcast</value>
                  </list>
                  <value>http://image:8080/tools.descartes.teastore.image/rest/adapt</value>
                  <value>DisableExternalImageProvider</value>
                </list>
              </parameter>
            </parameters>
          </action>
          <action type="DockerActionFactory">
            <parameters>
              <parameter key="factoryMethod" value="unpauseContainer"/>
              <parameter key="factoryArgTypes">
                <list>
                  <value>java.lang.String</value>
                </list>
              </parameter>
              <parameter key="factoryArgs">
                <list>
                  <value>adaptable_teastore_db</value>
                </list>
              </parameter>
            </parameters>
          </action>
        </actions>
      </event>
    </events>
  </scenario>
</scenarios>