<scenarios>
  <scenario id="benin-traffic" pluginId="adaptiflow.benin-traffic" enabled="true" intervalMs="5000">
    <events>
      <event id="traffic-increase" type="ConditionalEvent">
        <collector type="ResourceUsageCollector"/>
        <evaluators>
          <evaluator type="IncreaseResourceUsageEvaluator">
            <parameters>
              <parameter key="constructorArgTypes">
                <list>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                </list>
              </parameter>
              <parameter key="constructorArgs">
                <list>
                  <value>75.0</value>
                  <value>80.0</value>
                </list>
              </parameter>
            </parameters>
          </evaluator>
        </evaluators>
        <subscribers>
          <subscriber type="EventSubscriber">
            <actions>
              <action type="RestAdaptationAction">
                <parameters>
                  <parameter key="constructorArgTypes">
                    <list>
                      <value>java.util.List</value>
                      <value>java.lang.String</value>
                      <value>java.lang.String</value>
                    </list>
                  </parameter>
                  <parameter key="constructorArgs">
                    <list>
                      <list>
                        <value>EnableExternalImageProvider</value>
                      </list>
                      <value>http://image:8080/tools.descartes.teastore.image/rest/adapt</value>
                      <value>EnableExternalImageProvider</value>
                    </list>
                  </parameter>
                </parameters>
              </action>
            </actions>
          </subscriber>
        </subscribers>
      </event>
      <event id="traffic-decrease" type="ConditionalEvent">
        <collector type="ResourceUsageCollector"/>
        <evaluators>
          <evaluator type="DecreaseResourceUsageEvaluator">
            <parameters>
              <parameter key="constructorArgTypes">
                <list>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                  <value>tools.spirals.cerberus237.adaptiflow.interfaces.ThresholdProvider</value>
                </list>
              </parameter>
              <parameter key="constructorArgs">
                <list>
                  <value>60.0</value>
                  <value>60.0</value>
                </list>
              </parameter>
            </parameters>
          </evaluator>
        </evaluators>
        <subscribers>
          <subscriber type="EventSubscriber">
            <actions>
              <action type="RestAdaptationAction">
                <parameters>
                  <parameter key="constructorArgTypes">
                    <list>
                      <value>java.util.List</value>
                      <value>java.lang.String</value>
                      <value>java.lang.String</value>
                    </list>
                  </parameter>
                  <parameter key="constructorArgs">
                    <list>
                      <list>
                        <value>DisableExternalImageProvider</value>
                      </list>
                      <value>http://image:8080/tools.descartes.teastore.image/rest/adapt</value>
                      <value>DisableExternalImageProvider</value>
                    </list>
                  </parameter>
                </parameters>
              </action>
            </actions>
          </subscriber>
        </subscribers>
      </event>
    </events>
  </scenario>
</scenarios>